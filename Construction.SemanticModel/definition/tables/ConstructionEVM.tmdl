table ConstructionEVM
	lineageTag: 7bc14cf9-4090-4efc-91b2-975d7645f057

	measure 'Total Budget' = SUM(ConstructionEVM[Budget])
		formatString: 0
		lineageTag: 1cf91d3c-372a-4ac4-8f0a-1d39ed2e70ea

	measure 'Total Actual Cost' = SUM(ConstructionEVM[Actual Cost])
		formatString: 0
		lineageTag: 04f5220b-1402-4ce4-9f72-3484e688abfd

	measure 'Budget Variance' = [Total Actual Cost] - [Total Budget]
		formatString: 0
		lineageTag: b660634e-6fa0-4c7c-8e76-d3e2fb66ebd9

	measure 'Budget Variance %' = DIVIDE([Budget Variance],[Total Budget])
		formatString: 0.00
		lineageTag: be8585c1-cbd3-4832-a8af-6710d6933da2

	measure 'Total Earned Value' = SUM(ConstructionEVM[Earned Value])
		formatString: 0
		lineageTag: 6ce0c55b-1624-43de-98c3-c30fa194b200

	measure 'Cost Performance Index' = DIVIDE(ConstructionEVM[Total Earned Value],ConstructionEVM[Total Actual Cost])
